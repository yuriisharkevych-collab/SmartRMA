# Etap 7 — zmienne dla `docker-compose.prod.yml` (VPS/hosting produkcyjny).
# Skopiuj do `.env.prod`, wypełnij WSZYSTKO, NIGDY nie commituj.
#
#   cp .env.prod.example .env.prod
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# Zobacz docs/DEPLOYMENT.md po pełną procedurę pierwszego wdrożenia.

# --- Domena i sieć ---
# Musi już wskazywać (rekord A/AAAA) na IP tego serwera, ZANIM uruchomisz
# `caddy` — inaczej walidacja Let's Encrypt (HTTP-01) się nie powiedzie.
DOMAIN=twoja-domena.pl
CORS_ORIGIN=https://twoja-domena.pl
VITE_API_BASE_URL=https://twoja-domena.pl/api

# --- PostgreSQL — bindowane WYŁĄCZNIE do 127.0.0.1 (docker-compose.prod.yml), ale hasło i tak musi być prawdziwe ---
POSTGRES_USER=smartrma
POSTGRES_PASSWORD=wygeneruj-openssl-rand-hex-24
POSTGRES_DB=smartrma
POSTGRES_PORT=5432

# --- Redis — WYMAGANE hasło (dev docker-compose.yml go nie ma, ten plik tak) ---
REDIS_PASSWORD=wygeneruj-openssl-rand-hex-24
REDIS_PORT=6379

# --- Sekrety JWT/szyfrowania — WYGENERUJ NOWE, nigdy nie kopiuj z .env.example ---
# Polecenie do każdego z czterech poniżej: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
JWT_PORTAL_SECRET=
JWT_PORTAL_EXPIRES_IN=30m
ENCRYPTION_KEY=

BCRYPT_ROUNDS=12

LOG_LEVEL=info
