// --- Organizacja / dostęp ---

enum SubmissionMethod {
  Email
  PortalB2B
  FormularzWWW
}

enum TransportOrganizer {
  Klient
  Sklep
  Producent
}

// --- Reklamacje ---

// Dwie ścieżki decyzyjne procesu (kto merytorycznie rozstrzyga).
enum ComplaintType {
  Warranty
  StatutoryWarranty
}

// Kto faktycznie obsługuje zgłoszenie - wymiar NIEZALEŻNY od ComplaintType
// (np. StatutoryWarranty zawsze idzie przez sklep z mocy prawa, ale
// Warranty może iść przez sklep ALBO bezpośrednio do producenta).
enum SubmissionMode {
  PrzezSklep
  BezposrednioDoProducenta
}

enum ComplaintSource {
  SklepStacjonarny
  Email
  Telefon
  FormularzWWW
  Marketplace
  Inne
}

// Producent/Dystrybutor + Partnerzy B2B — typ organizacji (Company). `Shop`
// pozostaje domyślny (DAWIDAM i każda dotychczasowa firma) — zero zmiany
// zachowania dla istniejących wierszy. `ManufacturerDistributor` to nowy,
// równorzędny najemca współdzielący DOKŁADNIE ten sam panel/workflow (nie
// osobna aplikacja) — patrz `Company.orgKind` niżej dla rozróżnienia
// Producent/Dystrybutor w obrębie tego samego typu.
enum OrganizationType {
  Shop
  ManufacturerDistributor
}

// Sensowne WYŁĄCZNIE gdy `Company.type = ManufacturerDistributor` — jedna
// organizacja może być producentem LUB dystrybutorem (nie oba naraz),
// zgłaszane przy zakładaniu organizacji. Nie determinuje liczby marek —
// zarówno producent, jak i dystrybutor mogą obsługiwać wiele marek
// (`Brand[]` pod ich własnym, samoopisanym `Manufacturer`).
enum OrganizationKind {
  Producent
  Dystrybutor
}

// Producent/Dystrybutor + Partnerzy B2B — skąd sprawa trafiła do TEJ
// organizacji: `DirectCustomer` = przez jej WŁASNY publiczny formularz albo
// zarejestrowana przez jej pracownika, `PartnerB2B` = przekazana przez
// partnera (`CaseHandoff`). Niezależne od `ComplaintSource` (ten opisuje
// KANAŁ zgłoszenia klienta — telefon/e-mail/formularz, nie STRONĘ, od której
// sprawa przyszła). Domyślnie `DirectCustomer` — dla Sklepu (bez partnerów
// nadrzędnych w tej fazie) to jedyna sensowna wartość.
enum CaseOriginType {
  DirectCustomer
  PartnerB2B
}

// Formularz rozgałęziony marki (np. Veres Meble) — gdy partner B2B zgłasza
// sprawę W IMIENIU klienta końcowego, ta wartość mówi pracownikowi, z KIM
// prowadzić dalszą komunikację. `null` = nie dotyczy (zgłoszenie B2C albo
// B2B przedsprzedażowe, gdzie nie ma klienta końcowego). Celowo NIEZALEŻNE
// od `CaseOriginType`/`CaseHandoff` — to inny wymiar (kto fizycznie zgłosił
// sprawę do TEJ firmy, nie przekazanie między dwoma tenantami).
enum CaseContactPreference {
  Customer
  Partner
}

// Statusy obu ścieżek procesu w jednym enumie. Dozwolone przejścia (zależne
// od complaintType) waliduje warstwa aplikacji, nie baza danych - patrz
// WORKFLOW.md. OczekiwanieNaKlienta domyka lukę zidentyfikowaną podczas
// code review Portalu Klienta (status "oczekiwanie na klienta" nie miał
// wcześniej odpowiednika w modelu) - dostępny z każdego statusu aktywnego,
// wraca do Weryfikacja po uzupełnieniu danych przez klienta.
// 5-etapowy widok Portalu Klienta (BR-081 — klient nigdy nie widzi surowego
// statusu wewnętrznego). Każdy wiersz `CaseStatusDefinition` niesie DOKŁADNIE
// jedną z tych wartości; banery specjalne (Anulowana/Zarchiwizowana) są
// liczone poza tym enumem, z `Case.cancelledAt`/`archivedAt` — patrz
// `PortalMapper`.
enum PortalStage {
  Zgloszona
  Przyjeta
  WTrakcie
  Decyzja
  Zakonczona
}

// Sposób realizacji pozytywnej decyzji (WORKFLOW.md pkt 8 — Status Workflow
// Refactor). Wolny wybór, nie wpływa na logikę statusu.
enum DecisionFulfillmentMethod {
  Kurier
  OdbiorOsobisty
  PrzelewBankowy
  Inne
}

// Per-firma katalog statusów reklamacji — Status Workflow Refactor. Zastępuje
// sztywny enum `CaseStatus` + maszynę stanów (`case-status.rules.ts`,
// `workflow` module — oba usunięte). Pracownik może wybrać KAŻDY aktywny
// status w dowolnym momencie; ten model nie definiuje LEGALNYCH przejść,
// tylko metadane per status (czy jest finalny, czy wymaga potwierdzenia w UI,
// jaki twardy check odpalić przy wejściu, jak mapuje się na Portal Klienta).
// `code` jest niezmienny po utworzeniu (analogicznie do `Role.code` vs
// `Role.name`) — reszta pól edytowalna przez admina. Status NIGDY nie jest
// fizycznie usuwany (brak endpointu DELETE, wzorem `Manufacturer` i innych
// encji katalogowych w tym repo) — wyłącznie `active:false`, zablokowane,
// jeśli status jest używany przez aktywną (nie-finalną) sprawę.
model CaseStatusDefinition {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  code        String
  label       String
  description String?
  // WYŁĄCZNIE sortowanie listy + heurystyka "nietypowego przejścia" na
  // froncie (`abs(target.order - current.order) > 1 || target.order <= current.order`).
  // Nigdy nie blokuje wyboru — pracownik zawsze może wybrać dowolny aktywny status.
  order       Int     @default(0)

  active Boolean @default(true)

  // JEDYNE źródło prawdy "sprawa zamknięta" — zastępuje 7 niezależnych,
  // rozproszonych hardcodowanych zbiorów w Reports/Dashboard/Cases/frontend.
  isFinal              Boolean @default(false)
  // Dokładnie jeden aktywny wiersz per firma powinien mieć `true` — status
  // nadawany nowej sprawie przy utworzeniu.
  isDefaultForNew      Boolean @default(false)
  // UI pokazuje dodatkowy, twardszy krok potwierdzenia (niezależny od
  // heurystyki "nietypowego przejścia") gdy TEN status jest celem zmiany.
  requiresConfirmation Boolean @default(false)
  // Twardy check odpalany PRZY WEJŚCIU w ten status — 'CASE-002' (komplet
  // dokumentów wg wymagań producenta) | 'CASE-009' (decyzja musi być już
  // ustawiona) | null. Logika checków w 100% zachowana z poprzedniej wersji,
  // zmienia się tylko wyzwalacz.
  requiredCheck        String?

  portalStage                PortalStage
  defaultNextAction          String?
  notifyCustomerTemplateCode String?

  // Domyślne 9 statusów zasiane przy tworzeniu firmy — `code` niezmienny,
  // reszta pól nadal edytowalna przez admina (wzorzec `Role.isSystem`).
  isSystem Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, active])
}

// Wynik rozpatrzenia sprawy - odrębny od requestedResolution.
enum Decision {
  Naprawa
  WymianaCzesci
  WymianaProduktu
  ZwrotSrodkow
  Odrzucenie
}

enum CasePriority {
  Niski
  Normalny
  Wysoki
}

// Zamknięty słownik zdarzeń w CaseHistory - wymusza spójność danych.
// InfoRequested/PortalEnabled/PortalDisabled dodane podczas prototypowania
// Portalu Klienta (patrz DECISIONS.md) - tutaj domykane w modelu docelowym.
// LogisticsStatusChanged/PriorityChanged dodane w Zadaniu 5 - domykają lukę
// zgłoszoną w EVENTS.md §10.2/§13 (zdarzenia logistyczne i automatyczna
// eskalacja SLA zmieniały dane bez odpowiednika w historii sprawy).
enum CaseHistoryAction {
  CaseCreated
  StatusChanged
  DocumentAdded
  DocumentMarkedInvalid
  ManufacturerAssigned
  OwnerChanged
  DecisionSet
  NextActionUpdated
  ReplacementProductIssued
  ReplacementProductReturned
  InfoRequested
  PortalEnabled
  PortalDisabled
  NoteAdded
  MessageSent
  CaseClosed
  CaseCancelled
  CaseArchived
  LogisticsStatusChanged
  PriorityChanged
  CaseItemUpdated
  // Producent/Dystrybutor + Partnerzy B2B (Faza 5) — `HandoffSent` na OBU
  // stronach `CaseHandoff` (sprawie źródłowej i nowo utworzonej sprawie
  // partnera) w momencie przekazania. `HandoffPartnerUpdate` — wyłącznie na
  // sprawie źródłowej, doklejane przez `CaseHandoffPartnerUpdateHandler`
  // przy każdej zmianie statusu/decyzji sprawy PO STRONIE PARTNERA (baner
  // "aktualizacja od partnera", nie pole na żywo — patrz plan Fazy 5).
  HandoffSent
  HandoffPartnerUpdate
}

