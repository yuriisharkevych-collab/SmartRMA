// ============================================================================
// ORGANIZACJA (przygotowanie pod wielooddziałowość / przyszłe SaaS)
// ============================================================================

model Company {
  id                   String            @id @default(uuid())
  name                 String
  // Publiczny Formularz Reklamacyjny — rozstrzyga firmę PER ORGANIZACJA (zastępuje
  // dawne BR-086 "MVP ma dokładnie jedną Company"), więc `/reklamacja/:orgSlug` może
  // wskazać właściwą firmę bez sesji/tokenu. Nullable na starcie (istniejące wiersze
  // dostają wartość migracją wypełniającą), ale każda NOWA firma musi je mieć — patrz
  // `CompaniesService.create`.
  slug                 String?           @unique
  // Producent/Dystrybutor + Partnerzy B2B — patrz `OrganizationType`/`OrganizationKind`
  // wyżej. Domyślnie `Shop` — każda dotychczasowa firma (DAWIDAM) migruje bez zmiany
  // zachowania, `orgKind` zostaje `null` (sensowne wyłącznie dla drugiego typu).
  type                 OrganizationType  @default(Shop)
  orgKind              OrganizationKind?
  nip                  String?
  regon                String?
  address              String?
  email                String?
  phone                String?
  website              String?
  logoPath             String? // ścieżka względna w IStorageService, patrz storage.uploadsDir — serwowana przez GET /companies/:id/logo (publiczny, logo firmy nie jest danymą wrażliwą)
  // Portal Klienta — RODO (Zadanie: "sekcja RODO w Portalu Klienta"). Per firma, NIE
  // hardcoded — każda firma korzystająca ze SmartRMA wpisuje własny link, żeby produkt
  // pozostał uniwersalnym SaaS (nie jest powiązany wyłącznie z jednym najemcą).
  privacyPolicyUrl     String?
  // Opcjonalne oznaczenie wersji zewnętrznej polityki prywatności administratora —
  // zapisywane jako migawka w CaseConsent w chwili wyrażenia zgody, żeby móc wykazać,
  // do jakiej WERSJI treści klient się odniósł, nawet jeśli firma później ją podmieni.
  privacyPolicyVersion String?
  // Publiczny Formularz Reklamacyjny — link "Regulamin", wyświetlany obok Polityki
  // Prywatności na kroku RODO. Sam tekst regulaminu żyje poza SmartRMA (link, nie CMS).
  termsUrl             String?
  active               Boolean           @default(true)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  shops                     Shop[]
  users                     User[]
  employees                 Employee[]
  customers                 Customer[]
  contractors               Contractor[]
  manufacturers             Manufacturer[]
  brands                    Brand[]
  products                  Product[]
  productCategories         ProductCategory[]
  orders                    Order[]
  cases                     Case[]
  roles                     Role[]
  notificationTemplates     NotificationTemplate[]
  notifications             Notification[]
  auditLogs                 AuditLog[]
  settings                  Setting[]
  companySettings           CompanySettings?
  aiSettings                AiSettings?
  emailSettings             EmailSettings?
  caseStatusDefinitions     CaseStatusDefinition[]
  partnershipsAsShop        Partnership[]          @relation("PartnershipAsShop")
  partnershipsAsDistributor Partnership[]          @relation("PartnershipAsDistributor")
  // Sprawy INNYCH firm, gdzie ta firma jest zgłaszającym partnerem B2B — patrz
  // `Case.reportedByPartnerCompanyId`. Odwrotność `cases` wyżej (tamto: sprawy
  // WŁASNE tej firmy).
  reportedCasesAsPartner    Case[]                 @relation("CaseReportedByPartnerCompany")

  @@index([name])
}

// Ustawienia operacyjne firmy — 1:1 z Company. Osobna tabela (nie kolumny na
// Company) celowo: Company to tożsamość firmy (dane do wydruków/PDF), ta
// tabela to KONFIGURACJA zachowania systemu (numeracja, polityka
// bezpieczeństwa) — różne cykle życia, różne uprawnienia edycji w praktyce.
// getOrCreateDefaults w CompanySettingsService tworzy wiersz leniwie przy
// pierwszym odczycie/zapisie — brak wiersza = wartości domyślne poniżej.
model CompanySettings {
  id        String  @id @default(uuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id])

  // Numeracja reklamacji (zastępuje hardcoded "RMA/{rok}/{seq}" z CasesService)
  caseNumberPrefix      String  @default("RMA")
  caseNumberPadding     Int     @default(5)
  caseNumberResetYearly Boolean @default(true)

  // Polityka haseł (egzekwowana w UsersService przy tworzeniu konta)
  passwordMinLength        Int     @default(8)
  passwordRequireUppercase Boolean @default(true)
  passwordRequireNumber    Boolean @default(true)
  passwordRequireSymbol    Boolean @default(false)

  // Sesja i blokada konta (egzekwowane w AuthService). sessionTimeoutMinutes
  // steruje czasem życia refresh tokena (realna długość sesji — po jego
  // wygaśnięciu użytkownik musi zalogować się ponownie), NIE access tokena
  // (ten pozostaje krótkotrwały i cichy dla użytkownika, JWT_ACCESS_EXPIRES_IN).
  // Domyślnie 10080 min = 7 dni, żeby nie skracać sesji istniejącym wdrożeniom
  // w chwili włączenia tej funkcji (dotychczasowy globalny domyślny
  // JWT_REFRESH_EXPIRES_IN to też 7d).
  sessionTimeoutMinutes  Int     @default(10080)
  maxLoginAttempts       Int     @default(5)
  lockoutDurationMinutes Int     @default(15)
  twoFactorEnabled       Boolean @default(false) // placeholder — 2FA nie jest zaimplementowane

  // Logowanie PIN-em (User.loginMethod=Pin) — alternatywa dla hasła, wyłącznie
  // dla kont, które NIE mają roli Administrator/Kierownik (egzekwowane w
  // UsersService, patrz USER-006). Wyłączone domyślnie — firma musi świadomie
  // włączyć ten słabszy mechanizm uwierzytelniania. `maxPinAttempts`/
  // `pinLockoutDurationMinutes` są CELOWO odrębne od `maxLoginAttempts`/
  // `lockoutDurationMinutes` haseł: PIN ma mniejszą przestrzeń kombinacji,
  // więc próg blokady jest niższy, a okno blokady dłuższe. Licznik nieudanych
  // prób PIN żyje w Redis (PinLoginAttemptStoreService), NIE w LoginEvent —
  // patrz komentarz przy User.loginMethod.
  pinLoginEnabled           Boolean @default(false)
  pinLength                 Int     @default(6)
  maxPinAttempts            Int     @default(3)
  pinLockoutDurationMinutes Int     @default(30)

  // Przypomnienia o reakcji — wartości DOMYŚLNE dla całej firmy, per-producent
  // nadpisanie żyje na `ManufacturerSLA` (`statusStaleDaysOverride`/
  // `caseAgeStaleDaysOverride`). `null` = próg wyłączony (żaden alert tego
  // rodzaju). Dwie NIEZALEŻNE podstawy liczenia dni (właściciel: "oba —
  // osobno"): `defaultStatusStaleDays` liczy od ostatniej zmiany statusu
  // sprawy (`Case.statusChangedAt`), `defaultCaseAgeStaleDays` liczy od
  // zgłoszenia (`Case.createdAt`) i nigdy się nie resetuje.
  defaultStatusStaleDays  Int?
  defaultCaseAgeStaleDays Int?

  updatedAt DateTime @updatedAt

  @@index([companyId])
}

// Flagi konfiguracyjne przyszłych funkcji SmartRMA AI. Celowo BEZ żadnej
// logiki konsumującej te flagi gdziekolwiek w kodzie — to przygotowanie
// miejsca w UI/API pod przyszły moduł, nie włącznik istniejącej funkcji
// ("Nie implementuj jeszcze AI. Przygotuj konfigurację przyszłego modułu.").
// Wszystkie domyślnie wyłączone.
model AiSettings {
  id        String  @id @default(uuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id])

  monitorCompleteness       Boolean @default(false)
  trackDeadlines            Boolean @default(false)
  draftCustomerReplies      Boolean @default(false)
  draftManufacturerMessages Boolean @default(false)
  analyzeHistory            Boolean @default(false)
  generateDailyPlan         Boolean @default(false)
  analyzePhotos             Boolean @default(false)
  findSimilarCases          Boolean @default(false)

  updatedAt DateTime @updatedAt

  @@index([companyId])
}

// Moduł wysyłki e-mail (Zadanie: "moduł wysyłki wiadomości e-mail, obowiązkowy
// przed wdrożeniem") — 1:1 z Company, jak AiSettings/CompanySettings powyżej.
// `provider` przełącza dostawcę bez zmian w kodzie (SmtpTransport obsługuje
// Smtp/Microsoft365/GoogleWorkspace identycznie — to tylko czytelniejsze
// wartości w UI/wsparciu; ResendTransport dla Resend). Sekrety (hasło
// SMTP/klucz API) trzymane WYŁĄCZNIE zaszyfrowane (EncryptionService,
// AES-256-GCM) — nigdy jawnym tekstem w bazie ani w odpowiedzi API (patrz
// CompanySettingsService.getEmailSettings — mapuje na widok z flagami
// has*, nie z odszyfrowaną wartością).
model EmailSettings {
  id        String  @id @default(uuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id])

  provider    EmailProvider @default(Smtp)
  senderName  String?
  senderEmail String?

  smtpHost              String?
  smtpPort              Int?
  smtpUsername          String?
  smtpPasswordEncrypted String?
  smtpEncryption        SmtpEncryption @default(Tls)

  resendApiKeyEncrypted String?

  updatedAt DateTime @updatedAt

  @@index([companyId])
}

enum EmailProvider {
  Smtp
  Resend
  Microsoft365
  GoogleWorkspace
}

enum SmtpEncryption {
  None
  Tls
  Ssl
}

model Shop {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  name       String
  address    String?
  city       String?
  postalCode String?
  phone      String?
  email      String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  users     User[]
  employees Employee[]
  orders    Order[]
  cases     Case[]

  @@index([companyId])
}

// ============================================================================
// TOŻSAMOŚĆ I DOSTĘP (RBAC oparte o dane, nie o enum)
// ============================================================================

// Role systemowe SĄ DANYMI (nie enumem) — zgodnie z ROLES_AND_PERMISSIONS.md:
// "System powinien pozwalać na przypisanie użytkownikowi wielu ról" oraz z
// wymaganiem RBAC.md o pełnej konfigurowalności uprawnień. companyId=null
// oznacza rolę systemową (seedowaną, dostępną dla każdej firmy, niekasowalną
// - patrz isSystem); companyId ustawione = rola niestandardowa danej firmy.
model Role {
  id          String   @id @default(uuid())
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id])
  name        String // np. "Pracownik Działu Reklamacji"
  code        String // np. "Pracownik" - stabilny identyfikator używany w kodzie/gatingu UI
  description String?
  isSystem    Boolean  @default(false) // role seedowane (5 ról z RBAC.md) - niekasowalne, edytowalne tylko w zakresie uprawnień
  createdAt   DateTime @default(now())

  permissions RolePermission[]
  users       UserRoleAssignment[]

  // Zadanie 9 (decyzja końcowa, patrz DECISIONS.md) — `@@unique([companyId, code])`
  // NIE wystarcza: Postgres traktuje NULL jako różny od NULL w indeksie unikalnym,
  // więc nic nie blokowałoby dwóch ról systemowych (`companyId=null`) o tym samym
  // `code`. Prisma nie ma atrybutu dla `NULLS NOT DISTINCT` (Postgres 15+), więc
  // prawdziwa unikalność (włącznie z partycją `companyId IS NULL`) jest egzekwowana
  // ręcznie dopisanym ograniczeniem w migracji, NIE przez ten atrybut — poniższy
  // indeks wspiera wyłącznie wydajność zapytań. Patrz DATABASE.md §3.
  @@index([companyId, code])
}

// Pojedyncze uprawnienie - "moduł.akcja", patrz RBAC.md dla pełnej listy.
model Permission {
  id          String @id @default(uuid())
  code        String @unique // np. "cases.status.change", "manufacturers.manage"
  module      String // grupowanie w UI: "Cases", "Manufacturers", "Users", "Reports", "Settings", ...
  description String

  roles RolePermission[]

  @@index([module])
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

// Wiele ról na użytkownika - wprost wymagane przez ROLES_AND_PERMISSIONS.md
// ("właściciel jako Kierownik i Administrator jednocześnie"). Efektywne
// uprawnienia użytkownika to suma uprawnień wszystkich przypisanych ról.
model UserRoleAssignment {
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  roleId     String
  role       Role     @relation(fields: [roleId], references: [id])
  assignedAt DateTime @default(now())

  @@id([userId, roleId])
}

// `User.loginMethod` — Password (domyślny, dotychczasowe zachowanie) albo
// Pin (nowość: PIN zamiast hasła, wyłącznie dla kont bez roli
// Administrator/Kierownik, patrz USER-006 w UsersService). Wprowadzone na
// wyraźne żądanie właściciela: wiele stanowisk w firmie dzieli JEDEN
// wspólny adres e-mail firmowy, więc `email` przestał być wystarczającym
// identyfikatorem konta — PIN odróżnia konkretnego pracownika pod tym
// samym e-mailem.
enum LoginMethod {
  Password
  Pin
}

// User = tożsamość UWIERZYTELNIANIA (login, hasło/PIN, role, dostęp do
// systemu). Celowo ODDZIELONE od Employee (dane kadrowe) - nie każdy User
// jest pracownikiem etatowym (np. rola "Serwis" może reprezentować
// zewnętrznego technika z ograniczonym dostępem, bez rekordu Employee).
// Klienci NIE mają rekordu User - dostęp do Portalu Klienta jest odrębnym
// mechanizmem (Case.clientAccessCodeHash), nie kontem systemowym.
//
// `email` CELOWO NIE jest już globalnie `@unique` na poziomie Prisma —
// konta `loginMethod=Pin` mogą świadomie dzielić ten sam e-mail (patrz
// komentarz przy `LoginMethod`). Unikalność e-maila jest nadal egzekwowana,
// ale WYŁĄCZNIE wśród kont `loginMethod=Password`, częściowym indeksem
// dopisanym ręcznie w migracji (`CREATE UNIQUE INDEX ... WHERE
// "loginMethod" = 'Password'`) — dokładnie ten sam wzorzec "prawdziwa
// unikalność poza atrybutem Prisma", co już istnieje dla `Role.code`
// (patrz komentarz przy `Role.@@index([companyId, code])`). Aplikacyjny
// odpowiednik (USER-001) w `UsersService.create` też sprawdza kolizję
// TYLKO wśród kont Password.
model User {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  shopId    String? // główny/domyślny oddział - nullable dla ról bez stałego przypisania (np. Administrator centralny)
  shop      Shop?   @relation(fields: [shopId], references: [id])

  firstName    String
  lastName     String
  email        String
  loginMethod  LoginMethod @default(Password)
  passwordHash String? // ustawiane wyłącznie dla loginMethod=Password
  pinHash      String? // ustawiane wyłącznie dla loginMethod=Pin — hashowane tym samym PasswordService (bcrypt), to tylko ciąg znaków
  active       Boolean     @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime    @default(now())

  // Fundament „Fresh Install” — potwierdzenie adresu e-mail + self-service reset hasła.
  // `emailVerifiedAt` — `null` = konto NIE może się jeszcze zalogować hasłem (patrz
  // AUTH-007, AuthService.validatePasswordLogin), o ile wymaga weryfikacji (patrz niżej).
  // Migracja BACKFILLUJE tę kolumnę `= createdAt` dla WSZYSTKICH istniejących wierszy —
  // każde konto sprzed tej zmiany (bootstrap scripts, panel admina, akceptacja
  // zaproszenia partnera — wszystkie ścieżki poza publicznym `/companies/signup`)
  // zostaje potraktowane jako już zweryfikowane, zero regresji w logowaniu.
  emailVerifiedAt DateTime?
  // Token jednorazowy (SHA-256, NIGDY plaintext — patrz `common/utils/account-token.util.ts`,
  // ten sam kompromis co `Partnership.inviteTokenHash`) — WYŁĄCZNIE bieżący, ważny token;
  // ponowne wysłanie / zużycie nadpisuje albo czyści to pole, więc historii się tu nie trzyma
  // (nie jest potrzebna — `AuditLog` i tak zapisuje fakt wysłania/weryfikacji).
  emailVerificationTokenHash       String?
  emailVerificationTokenExpiresAt  DateTime?
  // „Nie pamiętam hasła” — identyczny wzorzec jak wyżej, osobne pole (inny TTL, inny cykl
  // życia: nie każde konto kiedykolwiek go użyje, w przeciwieństwie do weryfikacji e-mail).
  passwordResetTokenHash           String?
  passwordResetTokenExpiresAt      DateTime?

  roles               UserRoleAssignment[]
  employee            Employee?
  ownedCases          Case[]               @relation("CaseOwner")
  decidedCases        Case[]               @relation("CaseDecisionBy")
  uploadedDocuments   Document[]
  historyEntries      CaseHistory[]
  notes               Note[]
  messages            Message[]
  auditLogs           AuditLog[]
  loginEvents         LoginEvent[]
  invitedPartnerships Partnership[]
  createdCaseHandoffs CaseHandoff[]

  @@index([email])
  @@index([companyId])
  @@index([emailVerificationTokenHash])
  @@index([passwordResetTokenHash])
}

// Fundament „Fresh Install" — Administrator PLATFORMY SmartRMA, celowo
// CAŁKOWICIE ROZŁĄCZNY z User/Company: brak jakiejkolwiek relacji/FK do
// tenanta. To nie „User z companyId=null" (świadomie odrzucone — User.companyId
// zostaje WYMAGANE, żeby nie musieć przemyśleć na nowo całego modelu
// bezpieczeństwa opartego dziś na tym założeniu, patrz każdy findFirst({where:
// {id, companyId}}) w repozytoriach) — to ZUPEŁNIE INNY byt, uwierzytelniany
// osobnym sekretem JWT (PlatformAuthConfig, INNY niż JwtConfig/PortalConfig,
// dokładnie ten sam wzorzec rozdzielenia co Portal Klienta) i osobnym guardem
// (PlatformAuthGuard), nigdy przepuszczanym przez PermissionsGuard/
// RequirePermissions (te operują na Role/Permission per-tenant). Efekt:
// nawet błąd w kodzie nie może przez pomyłkę nadać Platform Adminowi
// uprawnień/danych JAKIEGOKOLWIEK tenanta — nie istnieje ścieżka zapytania,
// którą dałoby się tak skierować.
model PlatformAdmin {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
}

// Dane kadrowe - stanowisko, data zatrudnienia. Relacja 1:1 z User,
// OPCJONALNA (nie każdy User to Employee - patrz komentarz przy User).
model Employee {
  id        String  @id @default(uuid())
  userId    String  @unique
  user      User    @relation(fields: [userId], references: [id])
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  shopId    String?
  shop      Shop?   @relation(fields: [shopId], references: [id])

  employeeNumber  String?
  position        String?
  hireDate        DateTime?
  terminationDate DateTime?
  active          Boolean   @default(true)

  @@index([companyId])
}

// Zdarzenie logowania - odrębne od AuditLog (AuditLog to log ZDARZEŃ
// SYSTEMOWYCH/zmian danych; LoginEvent to węższy, częsty log wyłącznie
// logowań, żeby nie zaśmiecać AuditLog setkami identycznych wpisów
// "LOGIN_SUCCESS" - ale oba mają wspólny rodowód koncepcyjny).
model LoginEvent {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  ipAddress String?
  userAgent String?
  success   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ============================================================================
// KLIENCI
// ============================================================================

model Customer {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  firstName  String
  lastName   String
  phone      String
  email      String?
  // `address` = ulica i numer (domu/mieszkania), zgodnie z konwencją nazewnictwa
  // już użytą w `Shop` (patrz niżej) — `city`/`postalCode` osobno, żeby dało się
  // je pokazać/wyeksportować oddzielnie, bez parsowania jednego wolnego tekstu.
  address    String?
  city       String?
  postalCode String?
  notes      String?
  createdAt  DateTime @default(now())

  orders Order[]
  cases  Case[]

  @@index([companyId])
  @@index([lastName])
  @@index([phone])
  @@index([email])
}

// ============================================================================
// PRODUCENCI / MARKI / KATALOG PRODUKTÓW
// ============================================================================

// ============================================================================
// KONTRAHENCI — ogólna encja partnera biznesowego (dostawca, dystrybutor,
// firma logistyczna, producent). "Producent" (Manufacturer) to
// WYSPECJALIZOWANY PROFIL kontrahenta, dotyczący wyłącznie obsługi
// reklamacji - nie każdy Contractor musi mieć taki profil (np. kontrahent
// będący wyłącznie dostawcą opakowań nie obsługuje reklamacji). Dane
// firmowe (nazwa, NIP, adres, kontakt) żyją WYŁĄCZNIE tutaj, nie są
// duplikowane na Manufacturer - patrz DATABASE.md dla pełnego uzasadnienia
// tego podziału.
// ============================================================================

enum ContractorCategory {
  Manufacturer // producent/gwarant - typowy przypadek z profilem Manufacturer
  Distributor // dystrybutor wielu marek - typowy przypadek z profilem Manufacturer
  LogisticsPartner // firma kurierska/spedycyjna
  Supplier // dostawca inny niż producent (np. opakowań)
  Other
}

model Contractor {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  name          String
  category      ContractorCategory @default(Manufacturer)
  country       String?
  nip           String?
  address       String?
  contactEmail  String?
  contactPhone  String?
  contactPerson String?
  active        Boolean            @default(true)
  createdAt     DateTime           @default(now())

  manufacturerProfile Manufacturer?
  decidedCases        Case[]        @relation("CaseDecisionContractor")
  reportedCases       Case[]        @relation("CaseReportedByContractor")

  @@unique([companyId, nip])
  @@index([companyId])
  @@index([name])
}

// ----------------------------------------------------------------------------
// Producent — profil kontrahenta specyficzny dla OBSŁUGI REKLAMACJI. Relacja
// 1:1 z Contractor (nie każdy kontrahent ma ten profil; kontrahent BEZ
// profilu Manufacturer nie może zostać przypisany do żadnej marki/produktu).
// ----------------------------------------------------------------------------

model Manufacturer {
  id           String     @id @default(uuid())
  contractorId String     @unique
  contractor   Contractor @relation(fields: [contractorId], references: [id])
  companyId    String // denormalizacja - ułatwia zapytania bez JOIN przez Contractor
  company      Company    @relation(fields: [companyId], references: [id])

  submissionMethod        SubmissionMethod @default(Email)
  // Adres, na który wysyła się zgłoszenie reklamacyjne - ODRĘBNY od
  // Contractor.contactEmail (ogólny kontakt handlowy). Wielu producentów ma
  // osobną skrzynkę reklamacyjną (rma@, serwis@) i wysłanie zgłoszenia na
  // adres handlowy kończy się brakiem odpowiedzi.
  complaintEmail          String?
  portalUrl               String?
  portalLogin             String?
  portalPasswordEncrypted String? // BACKEND TODO: szyfrowanie aplikacyjne (nie hash - hasło musi być odzyskiwalne do logowania w portalu producenta), nigdy jawnie w API/UI poza formularzem edycji

  complaintProcedure      String?
  requiredDocumentsNote   String?
  requiredPhotosNote      String?
  requiredVideosNote      String?
  requiresSerialNumber    Boolean @default(false)
  requiresFrameNumber     Boolean @default(false)
  requiresProofOfPurchase Boolean @default(true)

  // Wymagania EGZEKWOWALNE (CASE-002) - odróżnione od notatek opisowych
  // powyżej, które są tylko podpowiedzią dla pracownika. `minPhotos=0`
  // oznacza brak wymogu; `maxPhotos` pozostaje górnym limitem.
  minPhotos     Int     @default(0)
  requiresVideo Boolean @default(false)

  maxPhotos           Int @default(6)
  maxAttachmentSizeMb Int @default(15)

  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  // Formularz publiczny per MARKA — dla firm, które prowadzą kilka linii
  // produktowych/marek pod JEDNĄ Company (jeden NIP), a chcą dla każdej
  // osobnego adresu i brandingu formularza (np. Veres Meble pod firmą
  // DAWIDAM). Odrębne od `Company.slug` (formularz per CAŁA firma,
  // istniejący mechanizm, bez zmian) — obie ścieżki działają równolegle:
  // `/reklamacja/:orgSlug` (firma) i `/reklamacja-marka/:brandSlug` (marka).
  // `null` = ten producent nie ma własnego formularza (typowy przypadek —
  // katalogowy profil zewnętrznego producenta, nie własna marka firmy).
  publicFormSlug        String? @unique
  publicFormLogoPath    String?
  publicFormDisplayName String?

  logistics  ManufacturerLogistics?
  automation ManufacturerAutomation?
  sla        ManufacturerSLA?
  brands     Brand[]
  products   Product[]
  categories ProductCategory[]
  caseItems  CaseItem[]

  @@index([companyId])
}

// Wydzielone jako osobna tabela (relacja 1:1), nie pole JSON na
// Manufacturer - łatwiej o walidację/indeksy/migracje pól logistycznych
// niezależnie od reszty danych producenta (patrz DECISIONS.md, uwaga o
// tym żeby logistics/automation nie zostały spłaszczone do JSON).
model ManufacturerLogistics {
  id             String       @id @default(uuid())
  manufacturerId String       @unique
  manufacturer   Manufacturer @relation(fields: [manufacturerId], references: [id])

  returnAddress              String?
  transportOrganizer         TransportOrganizer @default(Klient)
  manufacturerProvidesLabel  Boolean            @default(false)
  shopCanOrderCourier        Boolean            @default(false)
  shopCourierCost            Decimal            @default(0) @db.Decimal(10, 2)
  originalPackagingRequired  Boolean            @default(true)
  substitutePackagingAllowed Boolean            @default(true)
  transportProtectionNote    String?
  productConditionNote       String?
}

model ManufacturerAutomation {
  id             String       @id @default(uuid())
  manufacturerId String       @unique
  manufacturer   Manufacturer @relation(fields: [manufacturerId], references: [id])

  autoEmailEnabled Boolean @default(false)
  autoCloseEnabled Boolean @default(false)
  autoCloseDays    Int     @default(30)
}

// SLA producenta — brakujący moduł zgłoszony w code review po Etapie
// architektury: "odpowiedź do 14 dni / naprawa 21 dni / przypomnienie po
// 10 dniach / eskalacja po 14 dniach", konfigurowalne PER PRODUCENT (różni
// producenci mają różne warunki - patrz przykład Producent A / Producent B
// w docs/DECISIONS.md). Wszystkie pola nullable: `null` = brak progu
// skonfigurowanego dla tego producenta (np. "Producent B: brak
// przypomnień" to po prostu reminderAfterDays=null, nie osobna flaga
// włącz/wyłącz - jedno źródło prawdy zamiast dwóch niezależnych pól,
// które mogłyby się rozjechać, jak poprzednie autoReminders/autoEscalation
// jako osobne booleany od nieistniejących wtedy progów dniowych).
model ManufacturerSLA {
  id             String       @id @default(uuid())
  manufacturerId String       @unique
  manufacturer   Manufacturer @relation(fields: [manufacturerId], references: [id])

  // Oczekiwany czas odpowiedzi producenta na zgłoszenie (liczony od
  // wejścia sprawy w status WyslanaDoProducenta) - patrz WORKFLOW.md.
  responseDays Int?

  // Oczekiwany czas realizacji podjętej decyzji (naprawa/wymiana) -
  // liczony od wejścia sprawy w status RealizacjaDecyzji.
  repairDays Int?

  // Po ilu dniach od wysłania (bez odpowiedzi producenta) system wysyła
  // automatyczne przypomnienie. `null` = przypomnienia wyłączone dla tego
  // producenta.
  reminderAfterDays Int?

  // Po ilu dniach bez odpowiedzi/realizacji sprawa jest eskalowana
  // (priorytet -> Wysoki, powiadomienie do roli Kierownik). `null` =
  // eskalacja wyłączona dla tego producenta.
  escalationAfterDays Int?

  // Przypomnienia o reakcji ("od X dni status się nie zmienił") — nadpisanie
  // per producent wartości domyślnych z `CompanySettings.defaultStatusStaleDays`/
  // `defaultCaseAgeStaleDays`. `null` = użyj wartości domyślnej firmy (NIE
  // "wyłączone" — w przeciwieństwie do pól powyżej, gdzie `null` faktycznie
  // wyłącza mechanizm; tu brak nadpisania to inna informacja niż jawne
  // wyłączenie, którego to pole nie ma jak wyrazić — świadomie, bo "wyłącz
  // przypomnienia wyłącznie dla tego producenta" nie było częścią wymagania).
  statusStaleDaysOverride  Int?
  caseAgeStaleDaysOverride Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Marka - relacja jeden-do-wielu z Manufacturer (jeden producent/dystrybutor
// obsługuje wiele marek; marka należy do dokładnie jednego producenta -
// świadome uproszczenie, patrz DECISIONS.md).
model Brand {
  id             String       @id @default(uuid())
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id])
  manufacturerId String
  manufacturer   Manufacturer @relation(fields: [manufacturerId], references: [id])

  name   String
  active Boolean @default(true)

  // Etap 3 (Marki i konfiguracja procesu reklamacyjnego Producenta/Dystrybutora)
  // — OPCJONALNE nadpisania konfiguracji producenta (`Manufacturer` pozostaje
  // źródłem WARTOŚCI DOMYŚLNYCH, świadoma decyzja właściciela — NIE
  // duplikujemy pełnej konfiguracji na markę). `null` na KAŻDYM z tych pól =
  // "ta marka nie nadpisuje tego ustawienia, dziedzicz z producenta" —
  // rozstrzygane WYŁĄCZNIE przez `resolveRequirements`/`resolveAttentionSla`
  // (`manufacturers/requirements-resolver.ts`), nigdy przez odczyt tych pól
  // wprost gdzie indziej w kodzie. Lustro pól egzekwowalnych CASE-002/004/005/006
  // z `Manufacturer` — jeśli tam przybędzie nowe wymaganie, dodaj je i TU, i w
  // resolverze, nigdy w miejscu, które je faktycznie sprawdza.
  requiresSerialNumber    Boolean?
  requiresFrameNumber     Boolean?
  requiresProofOfPurchase Boolean?
  minPhotos               Int?
  requiresVideo           Boolean?
  maxPhotos               Int?
  maxAttachmentSizeMb     Int?

  // Nadpisanie SLA "przypomnień o reakcji" (`computeCaseAttention`) — lustro
  // DWÓCH z sześciu pól `ManufacturerSLA` (jedynych, które dziś faktycznie coś
  // liczą poza modułem Raporty: `responseDays`/`repairDays`/`reminderAfterDays`/
  // `escalationAfterDays` zasilają WYŁĄCZNIE agregacje Raportów, nie
  // egzekwowanie na sprawie — nadpisanie ich na poziomie marki zostaje poza
  // zakresem tego etapu, żeby nie dodawać pól, których żaden resolver jeszcze
  // nie czyta).
  statusStaleDaysOverride  Int?
  caseAgeStaleDaysOverride Int?

  products          Product[]
  partnershipBrands PartnershipBrand[]

  @@index([companyId])
  @@index([manufacturerId])
}

// Etap 4 (Produkty i konfiguracja formularza) — kategoria produktowa jako
// PEŁNOPRAWNA encja, nie wolny tekst (`Product.category`, zostaje nietknięte
// dla kompatybilności) ani płaska tablica (dawne `Manufacturer.productCategories`
// z Etapu 3, zmigrowane tutaj i USUNIĘTE — jedno źródło prawdy). Dokładnie ten
// sam wzorzec co `Brand`: własna marka/kategoria per Manufacturer, żeby druga
// firma z innej branży (np. TekstylPol) miała WŁASNY katalog, nigdy współdzielony
// z żadną inną firmą. `active=false` = dezaktywacja WIDOCZNOŚCI (formularz
// publiczny/panel), NIGDY usunięcie — istniejące `Product.categoryId` i
// historyczne sprawy zostają nietknięte (właściciel wprost tego wymagał).
model ProductCategory {
  id             String       @id @default(uuid())
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id])
  manufacturerId String
  manufacturer   Manufacturer @relation(fields: [manufacturerId], references: [id])

  name   String
  active Boolean @default(true)

  createdAt DateTime @default(now())

  products Product[]

  @@index([companyId])
  @@index([manufacturerId])
}

// ============================================================================
// PRODUCENT/DYSTRYBUTOR + PARTNERZY B2B
// ============================================================================

enum PartnershipStatus {
  Invited
  Active
  Inactive
  Rejected
}

// Współpraca Sklep ↔ Producent/Dystrybutor, scope'owana do konkretnych marek
// (`PartnershipBrand`). Cykl życia znacznikami czasu (jak `Case.closedAt`/
// `cancelledAt`), nie samym enumem — `status` i tak jest potrzebny do
// szybkiego filtrowania, ale znaczniki dają pełną historię bez osobnej
// tabeli audytowej. Izolacja "partner nie widzi innych partnerów" jest
// strukturalna (patrz `PartnershipsService`) — to nie jest tabela, przez
// którą można przypadkiem zapytać o cudze dane.
model Partnership {
  id                   String  @id @default(uuid())
  shopCompanyId        String
  shopCompany          Company @relation("PartnershipAsShop", fields: [shopCompanyId], references: [id])
  distributorCompanyId String
  distributorCompany   Company @relation("PartnershipAsDistributor", fields: [distributorCompanyId], references: [id])

  status          PartnershipStatus @default(Invited)
  invitedByUserId String
  invitedBy       User              @relation(fields: [invitedByUserId], references: [id])
  invitedAt       DateTime          @default(now())
  acceptedAt      DateTime?
  deactivatedAt   DateTime?

  // Etap 5 — zaproszenie partnera E-MAILEM, gdy `shopCompany` jeszcze NIE ISTNIEJE
  // (Dystrybutor zaprasza nową firmę, nie odwrotnie jak w `invite()`/slug powyżej).
  // `shopCompany` jest tworzona OD RAZU (pusta, bez użytkowników) w chwili
  // zaproszenia, żeby ten sam `Partnership`/`PartnershipBrand` obowiązywał od
  // razu — jedyne, co brakuje do aktywacji, to PIERWSZY User tej firmy, którego
  // zakłada sam zaproszony przez `PartnershipsService.acceptPartnerInvite`
  // (token jednorazowy, hash jak `Case.clientAccessCodeHash`). `null` na
  // wszystkich trzech = partnerstwo zawarte starym trybem (slug) albo już
  // zaakceptowane/token zużyty (czyszczony po użyciu, żeby nie dało się go
  // odtworzyć z bazy).
  inviteEmail          String?
  inviteTokenHash      String?
  inviteTokenExpiresAt DateTime?

  brands   PartnershipBrand[]
  handoffs CaseHandoff[]

  @@unique([shopCompanyId, distributorCompanyId])
  @@index([shopCompanyId])
  @@index([distributorCompanyId])
  @@index([inviteTokenHash])
}

model PartnershipBrand {
  id            String      @id @default(uuid())
  partnershipId String
  partnership   Partnership @relation(fields: [partnershipId], references: [id])
  brandId       String
  brand         Brand       @relation(fields: [brandId], references: [id])

  @@unique([partnershipId, brandId])
  @@index([partnershipId])
}

// Przekazanie sprawy między organizacjami (Sklep→Dystrybutor→Producent…) —
// CELOWO NIE współdzielony wiersz `Case` (patrz uzasadnienie architektoniczne,
// plan Fazy 1/2): przekazanie TWORZY nową, w pełni niezależną sprawę w
// tenancie partnera (`CasesService.create`, ta sama mechanika co zawsze),
// ten rekord jest wyłącznie WĄSKIM, audytowalnym łącznikiem między dwiema
// osobnymi sprawami — nie daje dostępu do pełnych danych drugiej strony,
// patrz `CaseHandoffService.getThread` (jawna lista dozwolonych pól).
// `originCaseId`/`targetCaseId` @unique — jedna sprawa ma najwyżej jedno
// przekazanie jako źródło i najwyżej jedno jako cel; łańcuch wieloetapowy
// (Sklep→Dystrybutor→Producent) to po prostu dwa powiązane rekordy, gdzie
// `targetCase` pierwszego jest `originCase` drugiego.
model CaseHandoff {
  id String @id @default(uuid())

  originCaseId    String @unique
  originCase      Case   @relation("HandoffOrigin", fields: [originCaseId], references: [id])
  originCompanyId String

  targetCaseId    String @unique
  targetCase      Case   @relation("HandoffTarget", fields: [targetCaseId], references: [id])
  targetCompanyId String

  partnershipId String
  partnership   Partnership @relation(fields: [partnershipId], references: [id])

  createdByUserId String
  createdBy       User     @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())

  @@index([originCompanyId])
  @@index([targetCompanyId])
  @@index([partnershipId])
}

// Product to POZYCJA KATALOGOWA (typ produktu), NIE konkretny egzemplarz
// zakupiony przez klienta - to jest zmiana względem wcześniejszego modelu
// MVP, gdzie "Product" był tworzony od nowa przy każdej reklamacji i
// faktycznie reprezentował egzemplarz. Konkretny zakupiony egzemplarz to
// teraz OrderItem (numer seryjny, data zakupu, dowód zakupu żyją tam).
// Patrz DATABASE.md dla pełnego uzasadnienia tej zmiany.
model Product {
  id             String       @id @default(uuid())
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id])
  manufacturerId String
  manufacturer   Manufacturer @relation(fields: [manufacturerId], references: [id])
  brandId        String?
  brand          Brand?       @relation(fields: [brandId], references: [id])

  name        String // model/nazwa produktu
  sku         String?
  // Etap 3 — wolny tekst, ZOSTAJE nietknięty dla istniejących wierszy (właściciel
  // wprost zabronił destrukcyjnej zmiany produktów). Nowe produkty (panel/formularz
  // publiczny od Etapu 4) ustawiają WYŁĄCZNIE `categoryId` poniżej — to pole jest
  // czystą kompatybilnością wsteczną, nieużywaną przez żaden nowy kod poza
  // odczytem/wyświetleniem starych wierszy.
  category    String?
  categoryId  String?
  categoryRef ProductCategory? @relation(fields: [categoryId], references: [id])
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())

  orderItems OrderItem[]
  caseItems  CaseItem[]

  @@index([companyId])
  @@index([manufacturerId])
  @@index([brandId])
  @@index([categoryId])
  @@index([name])
}

// ============================================================================
// ZAMÓWIENIA (katalog transakcji zakupowych - podstawa auto-uzupełniania
// danych produktu przy rejestracji reklamacji, patrz prototyp:
// "wyszukiwanie zamówienia po numerze" w kreatorze klienta, tam mockowane
// płaską tablicą MOCK_ORDERS - to jest jej docelowy odpowiednik).
// ============================================================================

model Order {
  id         String   @id @default(uuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  shopId     String?
  shop       Shop?    @relation(fields: [shopId], references: [id])
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  orderNumber String
  orderDate   DateTime
  totalAmount Decimal? @db.Decimal(10, 2)
  currency    String   @default("PLN")
  createdAt   DateTime @default(now())

  items OrderItem[]

  @@unique([companyId, orderNumber])
  @@index([customerId])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity      Int      @default(1)
  unitPrice     Decimal? @db.Decimal(10, 2)
  serialNumber  String?
  frameNumber   String?
  invoiceNumber String? // numer paragonu/faktury dla TEJ pozycji

  caseItems CaseItem[]

  @@index([orderId])
  @@index([productId])
  @@index([serialNumber])
}

// ============================================================================
// REKLAMACJE (Case = Complaint) — centralna encja systemu
// ============================================================================

model Case {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  shopId    String?
  shop      Shop?   @relation(fields: [shopId], references: [id])

  caseNumber String @unique // format: RMA/{rok}/{sekwencja}

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  ownerId String?
  owner   User?   @relation("CaseOwner", fields: [ownerId], references: [id])

  complaintType  ComplaintType
  submissionMode SubmissionMode  @default(PrzezSklep)
  source         ComplaintSource @default(SklepStacjonarny)
  // Producent/Dystrybutor + Partnerzy B2B — patrz `CaseOriginType` wyżej. Ustawiane
  // przez `CasesService.create` (domyślnie `DirectCustomer`) i nadpisywane na
  // `PartnerB2B` wyłącznie przez `CaseHandoffService` przy przekazaniu sprawy.
  originType     CaseOriginType  @default(DirectCustomer)

  // Formularz rozgałęziony marki, WARIANT "ta sama firma/NIP" (np. dawny mechanizm
  // Veres Meble pod DAWIDAM, zanim Veres Meble dostał WŁASNE konto Dystrybutora) —
  // `Contractor` (category=Distributor) tej samej `companyId`. Zastąpione przez
  // `reportedByPartnerCompanyId` dla marek z prawdziwym osobnym kontem — pole
  // zostaje w schemacie (nie usuwamy działającej ścieżki), przyda się każdej
  // przyszłej marce, która rzeczywiście dzieli NIP z właścicielem panelu.
  reportedByContractorId     String?
  reportedByContractor       Contractor?            @relation("CaseReportedByContractor", fields: [reportedByContractorId], references: [id])
  // Formularz rozgałęziony marki, WARIANT "osobne konto Dystrybutora" (Veres Meble od
  // teraz) — realna `Company` powiązana AKTYWNYM `Partnership` (shopCompanyId) z tą
  // firmą (distributorCompanyId), wybrana w kroku "Wybór partnera". Odróżnij od
  // `CaseHandoff`: to zgłoszenie WPROST do tej firmy przez publiczny formularz, nie
  // przekazanie już istniejącej sprawy między panelami. `null` dla zwykłych B2C.
  reportedByPartnerCompanyId String?
  reportedByPartnerCompany   Company?               @relation("CaseReportedByPartnerCompany", fields: [reportedByPartnerCompanyId], references: [id])
  contactPreference          CaseContactPreference?

  // Nazwa nadawcy dla WSZYSTKICH przyszłych powiadomień e-mail tej sprawy (np. "Veres
  // Meble") — zrzut wykonywany RAZ przy tworzeniu sprawy z formularza marki
  // (`IntakeService.submitBrandComplaint`), NIE żywe odwołanie do `Manufacturer` (marka
  // mogłaby zmienić nazwę/zniknąć później, a treść już wysłanych/przyszłych e-maili tej
  // sprawy ma zostać spójna). `null` = zwykłe zgłoszenie DAWIDAM, e-mail wysyłany z
  // nazwą nadawcy skonfigurowaną w Ustawienia → E-mail (bez zmiany zachowania).
  notificationSenderName String?

  // Zadanie 9 (decyzja końcowa) — nullable. Wymagane warstwą aplikacji dla
  // KAŻDEJ ścieżki OPRÓCZ sprawy monitorowanej `BezposrednioDoProducenta`
  // (WORKFLOW.md §3.2 — "bez opisu usterki, bez załączników", producent
  // zbiera je bezpośrednio). NULL oznacza "nie dotyczy tej sprawy", nie
  // "dane nieznane" — świadomie NIE syntetyzujemy tekstu-placeholdera,
  // patrz BUSINESS_RULES.md BR-105.
  requestedResolution String?
  description         String?
  customerStatement   String?

  // Status Workflow Refactor — kod z per-firma katalogu `CaseStatusDefinition`
  // (`code`), walidowany w warstwie serwisu (`CasesService`), NIE relacją FK —
  // `CaseHistory.previousValue/newValue` musi pozostać niezmienną migawką w
  // czasie niezależnie od późniejszej zmiany etykiety statusu przez admina.
  status   String
  priority CasePriority @default(Normalny)

  decision         Decision?
  decisionAt       DateTime?
  decisionByUserId String?
  decisionBy       User?     @relation("CaseDecisionBy", fields: [decisionByUserId], references: [id])

  // Status Workflow Refactor — dane decyzji rozszerzone poza sam enum `Decision`
  // (WORKFLOW.md pkt 8 nowego wymagania): kontrahent, uzasadnienie, sposób
  // realizacji, odpowiedź producenta/dystrybutora. `decisionIsPositive` liczone
  // serwerowo (`decision !== Odrzucenie`), nie ustawiane bezpośrednio przez klienta.
  decisionContractorId         String?
  decisionContractor           Contractor?                @relation("CaseDecisionContractor", fields: [decisionContractorId], references: [id])
  decisionIsPositive           Boolean?
  decisionJustification        String?
  decisionFulfillmentMethod    DecisionFulfillmentMethod?
  decisionManufacturerResponse String?

  nextAction        String?
  nextActionDueDate DateTime?

  requiresManagerApproval Boolean @default(false)
  isException             Boolean @default(false)

  // Pola z kreatora zgłoszenia (client-new-case.js) - domykają rozjazd
  // opisany w DECISIONS.md ("Kreator zgłoszenia reklamacyjnego").
  deliveryAddress        String?
  courierRequested       Boolean @default(false)
  preparationFeeAccepted Boolean @default(false)

  // Portal Klienta - domykają rozjazd opisany w DECISIONS.md (kilka rund
  // code review Portalu Klienta). Hashe/tokeny NIGDY jawnym tekstem.
  clientPortalEnabled   Boolean   @default(false)
  clientAccessCodeHash  String?
  clientAccessTokenHash String?
  clientAccessTokenUsed Boolean   @default(false)
  clientLastLoginAt     DateTime?

  createdAt   DateTime  @default(now())
  closedAt    DateTime?
  cancelledAt DateTime?
  archivedAt  DateTime?

  // Przypomnienia o reakcji ("od X dni status się nie zmienił") — `statusChangedAt`
  // aktualizowane WYŁĄCZNIE przy realnej zmianie statusu (`CasesService.performTransition`,
  // pomija idempotentny no-op wyboru tego samego statusu), NIE przy każdym zapisie
  // sprawy. `attentionNotifiedAt` zerowane w tym samym miejscu — świeży zegar po
  // każdej zmianie statusu, żeby jedna "epizoda" bezczynności generowała najwyżej
  // jedno powiadomienie (patrz `CaseAttentionScannerService`), nie jedno na każdy
  // przebieg harmonogramu.
  statusChangedAt     DateTime  @default(now())
  attentionNotifiedAt DateTime?

  items            CaseItem[]
  documents        Document[]
  history          CaseHistory[]
  notes            Note[]
  messages         Message[]
  logisticsEntries Logistics[]
  notifications    Notification[]
  consents         CaseConsent[]
  // Producent/Dystrybutor + Partnerzy B2B — `handoffAsOrigin` gdy TA sprawa
  // została przekazana partnerowi (istnieje sprawa-córka w jego tenancie),
  // `handoffAsTarget` gdy TA sprawa POWSTAŁA z przekazania (jest córką).
  // Jedna sprawa może być jednocześnie celem jednego przekazania i źródłem
  // kolejnego — tak buduje się łańcuch Sklep→Dystrybutor→Producent.
  handoffAsOrigin  CaseHandoff?   @relation("HandoffOrigin")
  handoffAsTarget  CaseHandoff?   @relation("HandoffTarget")

  @@index([companyId])
  @@index([caseNumber])
  @@index([status])
  @@index([ownerId])
  @@index([createdAt])
  // KAŻDE zapytanie raportowe filtruje po firmie ORAZ zakresie dat. Osobne indeksy
  // na `companyId` i `createdAt` zmuszają Postgresa do wyboru jednego z nich i
  // odfiltrowania reszty; indeks złożony obsługuje oba warunki naraz.
  @@index([companyId, createdAt])
  // Raporty pracowników i sklepów grupują po tych kolumnach w obrębie firmy.
  @@index([companyId, ownerId])
  @@index([companyId, shopId])
}

// Pozycja reklamacji - jeden Case może dotyczyć wielu produktów/egzemplarzy
// (np. klient reklamuje jednocześnie wózek i fotelik z tego samego
// zamówienia). To jest ROZSZERZENIE względem wcześniejszego modelu MVP,
// gdzie Case miał dokładnie jeden Product bezpośrednio - patrz DATABASE.md.
// W typowym, jednoelementowym zgłoszeniu (zdecydowana większość przypadków
// w dotychczasowym prototypie) istnieje dokładnie jeden CaseItem.
model CaseItem {
  id     String @id @default(uuid())
  caseId String
  case   Case   @relation(fields: [caseId], references: [id])

  // Powiązanie z faktycznie zakupionym egzemplarzem (gdy zamówienie zostało
  // odnalezione) - patrz kreator klienta, "auto-uzupełnianie po numerze
  // zamówienia". Nullable: zgłoszenie mogło powstać bez dopasowania do
  // zamówienia (ręczne wprowadzenie danych produktu).
  orderItemId String?
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id])

  // Fallback/denormalizacja gdy nie ma dopasowania do OrderItem - zawsze
  // wypełnione, niezależnie od orderItemId (ułatwia zapytania "wszystkie
  // reklamacje danego produktu" bez LEFT JOIN przez Order).
  productId String
  product   Product @relation(fields: [productId], references: [id])

  // Producent odpowiedzialny za TĘ pozycję - sugerowany automatycznie z
  // Product.manufacturerId, ale pracownik może go zmienić (ETAP 4 procesu).
  manufacturerId String?
  manufacturer   Manufacturer? @relation(fields: [manufacturerId], references: [id])

  description String // opis usterki TEJ pozycji
  quantity    Int    @default(1)

  // Dane KONKRETNEGO egzemplarza, którego dotyczy zgłoszenie. Nullable, bo
  // nie każdy produkt je ma (BR-074 - Product to typ/model, nie egzemplarz)
  // i nie każdy producent ich wymaga (Manufacturer.requiresSerialNumber/
  // requiresFrameNumber/requiresProofOfPurchase decydują, czy są obowiązkowe
  // - CASE-004/005/006).
  //
  // Celowo DUBLUJĄ pola o tych samych nazwach na OrderItem: tam opisują
  // egzemplarz sprzedany (fakt handlowy, niezmienny), tutaj egzemplarz
  // zgłoszony przez klienta. Gdy sprawa jest dowiązana do zamówienia
  // (orderItemId), zwykle są zgodne - ale klient potrafi zgłosić reklamację
  // bez odnalezionego zamówienia, a wtedy to jedyne miejsce, gdzie te dane
  // w ogóle istnieją. Były w prototypie (`case-new.html`: p-serial, p-frame,
  // p-purchaseDate, p-proof) od początku; brak ich w schemacie był luką.
  serialNumber        String?
  frameNumber         String?
  purchaseDate        DateTime?
  purchaseProofNumber String?

  replacementProduct ReplacementProduct?
  documents          Document[]

  @@index([caseId])
  @@index([productId])
  // Raporty grupują pozycje po producencie ("najczęściej reklamowani producenci",
  // skuteczność producenta) — bez tego każdy taki raport robi pełny skan CaseItem.
  @@index([manufacturerId])
}

// Historia sprawy - niemodyfikowalny dziennik biznesowy (odrębny od
// AuditLog, który dotyczy zdarzeń bezpieczeństwa/systemowych ogólnie).
model CaseHistory {
  id                 String            @id @default(uuid())
  caseId             String
  case               Case              @relation(fields: [caseId], references: [id])
  userId             String? // nullable: część wpisów tworzy system automatycznie
  user               User?             @relation(fields: [userId], references: [id])
  action             CaseHistoryAction
  previousValue      String?
  newValue           String?
  visibleForCustomer Boolean           @default(false) // czy wpis trafia do publicznej osi czasu Portalu Klienta
  createdAt          DateTime          @default(now())

  @@index([caseId])
}

// Wewnętrzne notatki pracowników - NIGDY widoczne dla klienta (odrębne od
// Message). Domyka odłożone wcześniej "notatki pracownika trafią do modelu
// Comment" (patrz komentarz w poprzednim schema.prisma przy Case.description).
model Note {
  id        String   @id @default(uuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseId])
}

// Komunikacja Z klientem (formularz kontaktowy Portalu Klienta + przyszła
// dwukierunkowa wymiana wiadomości) - formalizuje to, co w prototypie było
// wyłącznie mockiem (toast po wysłaniu formularza kontaktowego).
model Message {
  id           String           @id @default(uuid())
  caseId       String
  case         Case             @relation(fields: [caseId], references: [id])
  senderType   SenderType
  senderUserId String? // wypełnione, gdy senderType = Employee
  senderUser   User?            @relation(fields: [senderUserId], references: [id])
  direction    MessageDirection
  channel      MessageChannel
  subject      String?
  content      String
  // Załączniki do odpowiedzi (0..N, wcześniej 0..1) — dokumenty są tworzone OSOBNYM
  // uploadem (ta sama ścieżka co reszta załączników sprawy), wiadomość tylko się do
  // nich odwołuje przez `Document.messageId` (FK po stronie Document, nie Message —
  // odwrócone względem poprzedniej wersji 1:1, żeby jeden Message mógł mieć wiele
  // Document) — dzięki temu podgląd/pobranie pliku działa identycznie jak każdy inny
  // Document (uprawnienia, widoczność), bez duplikowania logiki storage.
  documents    Document[]
  sentAt       DateTime         @default(now())
  readAt       DateTime?

  @@index([caseId])
}

// Produkt zastępczy - powiązany z konkretną pozycją reklamacji (CaseItem),
// nie z całą sprawą, żeby poprawnie obsłużyć wieloelementowe reklamacje
// (każda pozycja może mieć własny produkt zastępczy).
model ReplacementProduct {
  id                String    @id @default(uuid())
  caseItemId        String    @unique
  caseItem          CaseItem  @relation(fields: [caseItemId], references: [id])
  productIdentifier String
  issuedAt          DateTime
  plannedReturnAt   DateTime?
  returnedAt        DateTime?
  conditionOnReturn String?
  notes             String?
}

// ============================================================================
// DOKUMENTY
// ============================================================================

model Document {
  id         String    @id @default(uuid())
  caseId     String
  case       Case      @relation(fields: [caseId], references: [id])
  caseItemId String? // nullable: dokument może dotyczyć całej sprawy lub konkretnej pozycji
  caseItem   CaseItem? @relation(fields: [caseItemId], references: [id])

  fileName     String
  fileType     DocumentType
  mimeType     String
  fileSize     Int
  storagePath  String
  category     DocumentCategory   @default(Other)
  visibility   DocumentVisibility @default(Internal)
  status       DocumentStatus     @default(Aktywny)
  // Nullable — Portal Klienta pozwala KLIENTOWI wgrywać załączniki (zdjęcia/wideo/PDF
  // przy uzupełnianiu zgłoszenia), a klient nigdy nie ma rekordu User (RBAC.md §1.2:
  // dostęp "rekordowy", nie modułowy). `null` = wgrane przez klienta w Portalu,
  // niezerowe = pracownik. Odróżnienie od "systemowego" (docs generowane automatycznie)
  // nie jest dziś potrzebne — jedyne dwa źródła uploadu to pracownik i klient.
  uploadedById String?
  uploadedBy   User?              @relation(fields: [uploadedById], references: [id])
  uploadedAt   DateTime           @default(now())
  version      Int                @default(1)
  // Wiadomość, do której ten dokument jest załącznikiem (opcjonalnie) — FK po stronie
  // Document (nie Message.documentId jak wcześniej), bez `@unique`, więc jedna Message
  // może mieć wiele Document. Jeden Document nadal należy do co najwyżej jednej Message.
  messageId    String?
  message      Message?           @relation(fields: [messageId], references: [id])

  @@index([caseId])
  @@index([messageId])
}

// Zgoda RODO wyrażona w Portalu Klienta przy uzupełnianiu zgłoszenia. Insert-only
// (jak AuditLog) — KAŻDE złożenie formularza tworzy NOWY wiersz zamiast nadpisywać
// poprzedni, żeby w przyszłości dało się wykazać dokładnie, na jaką treść klauzuli/
// polityki klient się zgodził w danym momencie, nawet jeśli treść później się zmieni.
model CaseConsent {
  id        String @id @default(uuid())
  caseId    String
  case      Case   @relation(fields: [caseId], references: [id])
  // Denormalizacja companyId (jak AuditLog) — pod przyszłe raporty/eksport zgód bez
  // joina przez Case, i pod izolację dzierżawy gdyby kiedyś potrzebny był bezpośredni odczyt.
  companyId String

  requiredConsent        Boolean // zgoda na przetwarzanie danych w celu obsługi reklamacji — obowiązkowa, formularz blokuje wysyłkę bez niej
  marketingConsent       Boolean @default(false) // zgoda na kontakt e-mail/SMS — opcjonalna, sugestia z zadania
  // Zgoda na udostępnienie załączonych dokumentów/zdjęć producentowi lub dystrybutorowi w celu
  // weryfikacji sprawy — opcjonalna (dotyczy wyłącznie spraw, które mogą zostać przekazane dalej,
  // patrz CaseHandoffService.copyDocuments). Domyślnie false dla wierszy sprzed tej kolumny.
  documentSharingConsent Boolean @default(false)

  // Migawka TREŚCI, na którą klient się zgodził — nie live-referencja, która mogłaby
  // się zmienić pod nogami już złożonej zgody.
  clauseVersion        String
  privacyPolicyUrl     String?
  privacyPolicyVersion String?

  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([caseId])
  @@index([companyId])
}

// ============================================================================
// LOGISTYKA — formalizuje ustalenia z kreatora zgłoszenia (odbiór/wysyłka
// kurierem) i z konfiguracji producenta (ManufacturerLogistics określa
// REGUŁY, ten model zapisuje KONKRETNE zdarzenia transportowe danej sprawy).
// ============================================================================

model Logistics {
  id     String @id @default(uuid())
  caseId String
  case   Case   @relation(fields: [caseId], references: [id])

  type            LogisticsType
  status          LogisticsStatus @default(Requested)
  courierProvider String?
  trackingNumber  String?
  cost            Decimal?        @db.Decimal(10, 2)
  addressSnapshot String? // adres w momencie zlecenia (może różnić się od danych klienta później zmienionych)
  scheduledAt     DateTime?
  completedAt     DateTime?
  createdAt       DateTime        @default(now())

  @@index([caseId])
}

// ============================================================================
// POWIADOMIENIA — centralny system (e-mail / w systemie / przyszłe SMS)
// ============================================================================

model NotificationTemplate {
  id        String   @id @default(uuid())
  companyId String? // nullable = szablon globalny/domyślny, dostępny dla każdej firmy
  company   Company? @relation(fields: [companyId], references: [id])

  code         String // np. "case.created.customer", "case.status_changed.customer" - patrz WORKFLOW.md/BUSINESS_RULES.md dla pełnej listy
  channel      NotificationChannel
  subject      String? // niewymagane dla channel=System
  bodyTemplate String // tekst z placeholderami {{caseNumber}}, {{customerName}}, ...
  variables    Json // lista oczekiwanych placeholderów, np. ["caseNumber","customerName","statusLabel"]
  active       Boolean             @default(true)
  createdAt    DateTime            @default(now())

  notifications Notification[]

  // Zadanie 9 (decyzja końcowa) — jak `Role.@@index([companyId, code])` powyżej:
  // to NIE jest pełna gwarancja unikalności, tylko indeks wydajnościowy. Prawdziwa
  // unikalność (w tym partycja `companyId IS NULL` — jeden szablon globalny na
  // `code`+`channel`, na czym opiera się rozwiązywanie w NOTIFICATIONS.md §2.2)
  // wymaga ręcznie dopisanego ograniczenia w migracji. Patrz DATABASE.md §27.
  @@index([companyId, code, channel])
}

model Notification {
  id         String                @id @default(uuid())
  companyId  String
  company    Company               @relation(fields: [companyId], references: [id])
  templateId String?
  template   NotificationTemplate? @relation(fields: [templateId], references: [id])

  channel                 NotificationChannel
  recipientType           NotificationRecipientType
  recipientUserId         String? // wypełnione, gdy recipientType = Employee
  recipientManufacturerId String? // wypełnione, gdy recipientType = Manufacturer (id producenta, bez formalnej relacji Prisma - analogicznie do recipientUserId)
  recipientEmail          String? // wypełnione dla channel = Email (klient nie ma User; dla producenta - adres skopiowany z Manufacturer.contractor.contactEmail w momencie utworzenia, patrz NOTIFICATIONS.md §5)
  recipientPhone          String? // wypełnione dla channel = SMS

  relatedCaseId String?
  relatedCase   Case?   @relation(fields: [relatedCaseId], references: [id])

  subject            String?
  body               String
  status             NotificationStatus @default(Pending)
  sentAt             DateTime?
  readAt             DateTime?
  failureReason      String?
  // Liczba prób faktycznej wysyłki przez NotificationDispatcherService — rośnie
  // przy każdej nieudanej próbie, dispatcher przestaje ponawiać po osiągnięciu
  // limitu (MAX_ATTEMPTS w mail module), żeby trwale zepsuta konfiguracja
  // e-mail nie była odpytywana w nieskończoność (EVENTS.md §11.2).
  attempts           Int                @default(0)
  createdAt          DateTime           @default(now())
  // Zrzut `Case.notificationSenderName` w chwili tworzenia TEGO powiadomienia (patrz
  // komentarz przy tym polu) — `MailService` nadpisuje nim nazwę nadawcy z Ustawienia →
  // E-mail przy faktycznej wysyłce. `null` = zachowanie bez zmian (nazwa firmy).
  senderNameOverride String?

  @@index([companyId])
  @@index([relatedCaseId])
  @@index([status])
}

// ============================================================================
// AUDYT — KAŻDA operacja w systemie (nie tylko logowania - te są w
// LoginEvent). previousValue/newValue jako Json, żeby faktycznie przechować
// strukturalną różnicę pól, nie tylko opisowy tekst.
// ============================================================================

model AuditLog {
  id        String   @id @default(uuid())
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  userId    String? // nullable: zdarzenia systemowe bez inicjatora-człowieka
  user      User?    @relation(fields: [userId], references: [id])

  action        String // np. "CASE_STATUS_CHANGED", "USER_ROLE_ASSIGNED", "MANUFACTURER_UPDATED"
  entityType    String // np. "Case", "User", "Manufacturer"
  entityId      String?
  ipAddress     String?
  previousValue Json?
  newValue      Json?
  createdAt     DateTime @default(now())

  @@index([companyId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ============================================================================
// USTAWIENIA — companyId=null to wartość domyślna systemu, nadpisywana per
// firma gdy companyId ustawione.
// ============================================================================

model Setting {
  id        String   @id @default(uuid())
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  key         String
  value       Json
  type        SettingValueType @default(String)
  description String?
  updatedAt   DateTime         @updatedAt

  // Zadanie 9 (decyzja końcowa) — jak `Role`/`NotificationTemplate` powyżej:
  // indeks wydajnościowy, NIE gwarancja unikalności. Prawdziwa unikalność
  // (w tym jedna wartość domyślna systemu na `key`, `companyId IS NULL`)
  // wymaga ręcznie dopisanego ograniczenia w migracji. Patrz DATABASE.md §30.
  @@index([companyId, key])
}
