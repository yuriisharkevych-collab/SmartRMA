# Skopiuj do .env i uzupełnij lokalnie. Nigdy nie commituj .env.

# --- Wspólne / Docker Compose ---
POSTGRES_USER=smartrma
POSTGRES_PASSWORD=smartrma
POSTGRES_DB=smartrma
POSTGRES_PORT=5432

REDIS_PORT=6379

# --- apps/api ---
NODE_ENV=development
PORT=3000
API_GLOBAL_PREFIX=api

DATABASE_URL="postgresql://smartrma:smartrma@localhost:5432/smartrma?schema=public"
REDIS_URL="redis://localhost:6379"

# JWT (Auth) — wygeneruj losowy sekret przed pierwszym uruchomieniem
JWT_ACCESS_SECRET=changeme-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=changeme-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# JWT (Portal Klienta) — sekret ODRĘBNY od powyższych, RBAC.md §1.2
JWT_PORTAL_SECRET=changeme-portal-secret
JWT_PORTAL_EXPIRES_IN=30m

# Hashowanie haseł (PasswordService, wyłącznie bcrypt)
BCRYPT_ROUNDS=10

# Katalog na załączniki (IStorageService, dysk lokalny w MVP).
# Ścieżka relatywna liczona od katalogu, z którego startuje API (apps/api).
UPLOADS_DIR=uploads

# CORS — adres frontendu dopuszczony do wywołań API
CORS_ORIGIN=http://localhost:5173

# Logger
LOG_LEVEL=debug

# --- apps/web ---
VITE_API_BASE_URL=http://localhost:3000/api
